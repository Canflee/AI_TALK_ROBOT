# 复制为 .env 后使用。除明确说明可留空的项外，其余都必填；
# 缺少必填项时程序会提示“配置错误: 缺少环境变量 XXX”。

# ===== 模型 =====
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_RETRIES=2

# ===== 运行 =====
DB_PATH=data/bot.db
PERSONAS_PATH=config/personas.yaml
LOG_LEVEL=INFO

# ===== 微信 4.x =====
# wechatauto：微信 4.x；console：控制台调试
ADAPTER=wechatauto
WECHAT4_INTERVAL=1.0
WECHAT_MAX_FILE_MB=25
WECHAT_MAX_STICKER_MB=20
SKIP_WECHAT_CHECK=false

# ===== 收发范围 =====
# 管理员 wxid，多个用英文逗号分隔
ADMIN_WXIDS=

# 只自动回复这些会话；留空表示所有会话都回复。多个用英文逗号分隔。
# 私聊填 wxid，群聊填 xxx@chatroom。
# 被挡掉的普通消息不会自动回复，也不会设置提醒；公开命令和管理命令不受限制。
REPLY_WHITELIST=
# 主动消息只发给这些私聊 wxid；留空则回退到 PROACTIVE_TARGET_WXID。
# 多个用英文逗号分隔；群聊（@chatroom）会被自动忽略。
# 建议同时把主动对象加入 REPLY_WHITELIST，否则对方回复时不会自动处理。
PROACTIVE_WHITELIST=

# ===== 回复行为 =====
BOT_NAME=小助手
# 发送前会去掉回复开头的这个名字，例如“小明，”；留空表示不处理
REPLY_TARGET_NAME=
BOT_WORKERS=4

REPLY_SPLIT_LIMIT=1500
REPLY_BUBBLE_LIMIT=80
REPLY_MAX_BUBBLES=8
REPLY_SEND_DELAY_MIN=0.6
REPLY_SEND_DELAY_MAX=1.6
SEND_ERROR_NOTICE=true
REPLY_DEBOUNCE=4.0
BATCH_MAX_MESSAGES=8
BATCH_MAX_CHARS=2000
# 群里没被 @ 时接话的概率，0 到 1
GROUP_BANTER_RATE=0.2
# 收到表情包时回复的概率，0 到 1
STICKER_REPLY_RATE=0.1
# ===== 图片 / PDF =====
OCR_MAX_IMAGES=3
PDF_MAX_FILES=2
PDF_MAX_PAGES=8
PDF_MAX_OCR_PAGES=5
PDF_MAX_CHARS=6000
PROMPT_MAX_IMAGES=4
PROMPT_MAX_IMAGE_SIDE=1600
PROMPT_IMAGE_QUALITY=85
# ===== 搜索 / 文章 =====
# 关闭后普通搜索和条件提醒都不会联网
# 明确说“搜一下 / 查一下 / 百度一下”等会直接搜索；
# 时效性问题会先规则快筛，再让模型判断是否需要搜索
WEB_SEARCH=true
SEARCH_INTENT_ENABLED=true
# deepseek-flash 是推理模型，会先消耗 reasoning token；
# 这两个值设太小会只剩空 content，建议至少 256
SEARCH_INTENT_MAX_TOKENS=256
SEARCH_QUERY_MAX_TOKENS=256
SEARCH_MAX_RESULTS=5
SEARCH_CACHE_SECONDS=300
# 搜索后抓取前几条网页正文，补足摘要里没有的实时数据；0 表示不抓
SEARCH_FETCH_PAGES=1
SEARCH_FETCH_MAX_CHARS=1200
SEARCH_FETCH_TIMEOUT_SECONDS=8
ARTICLE_MAX_CHARS=6000

# ===== B 站视频 =====
VIDEO_FRAME_COUNT=4
VIDEO_INFO_CACHE_SECONDS=600
VIDEO_FRAME_CACHE_SECONDS=600
VIDEO_FRAME_MIN_INTERVAL=5
VIDEO_DOWNLOAD_MAX_MB=80
# 分类权重，格式：类别:权重，多个用英文逗号分隔
# 下面用 default 作为通用示例，实际使用时改成自己的类别，并同步修改下面的分类配置
VIDEO_WEIGHTS=default:1.0

# 视频兴趣与文案配置
# 全局屏蔽词，英文逗号分隔；可留空
VIDEO_BAD_WORDS=政治,新闻,色情,暴力,恐怖
# 每个分类的搜索词，格式：分类=词1|词2;分类=词1|词2
# 分类名要与 VIDEO_WEIGHTS 中的类别一致
VIDEO_CATEGORY_KEYWORDS=default=视频 分享|视频 合集|热门 视频
# 每个分类标题里必须出现的匹配词，格式同上；留空表示不按标题过滤
VIDEO_CATEGORY_TERMS=default=视频|分享|合集
# 每个分类的额外屏蔽词，格式同上；可留空
VIDEO_CATEGORY_BAD_WORDS=
# 分类默认话题标签，格式：分类=标签;分类=标签
VIDEO_CATEGORY_TOPICS=default=视频
# 标题命中关键词后使用的话题标签，格式：分类.关键词=标签，多个用英文逗号分隔；可留空
VIDEO_TOPIC_RULES=
# 按话题标签配置分享语兜底，格式：标签=句子，多个用英文逗号分隔
VIDEO_TOPIC_FALLBACKS=视频=这个视频有点东西
# 没有匹配到话题时使用的兜底分享语
VIDEO_DEFAULT_FALLBACK=这个有点意思
# 视频分享提示词的额外要求，可留空
VIDEO_SHARE_EXTRA_HINT=
VIDEO_MIN_PLAY=50000
VIDEO_FALLBACK_MIN_PLAY=10000
VIDEO_MIN_DURATION=30
VIDEO_MAX_DURATION=600
VIDEO_FRESHNESS_DAYS=365
VIDEO_TOP_CANDIDATES=2
VIDEO_SEARCH_LIMIT=10
VIDEO_HISTORY_LIMIT=100
VIDEO_CACHE_SECONDS=600
VIDEO_POPULAR_FRESHNESS_DAYS=90
# ===== 提醒调度 =====
REMINDER_CHECK_SECONDS=30
# 条件提醒：每隔多少秒扫描一次、每条条件多久检查一次、失败后多久重试
# 每次检查都会联网搜索并调用模型，间隔越短 API 消耗越大
# 默认 15 分钟；用户说“每5分钟提醒我”时，这条条件会单独用 5 分钟
CONDITION_CHECK_SECONDS=30
CONDITION_INTERVAL_MINUTES=15
CONDITION_RETRY_MINUTES=15
# 条件提醒的搜索缓存秒数；0 表示每次检查都重新搜索
CONDITION_SEARCH_CACHE_SECONDS=0
# 条件提醒最多保留多少天，到期自动取消
CONDITION_EXPIRE_DAYS=7
# 生成搜索词 / 判断条件用的 token 上限；推理模型建议至少 256
CONDITION_QUERY_MAX_TOKENS=256
CONDITION_JUDGE_MAX_TOKENS=256
# 判断条件时最多塞入多少字符的搜索结果
CONDITION_CONTEXT_CHARS=3000
# ===== 主动消息 =====
PROACTIVE_ENABLED=true
# 兼容旧配置：只配置一个主动消息对象时可以用这个，PROACTIVE_WHITELIST 优先。
PROACTIVE_TARGET_WXID=
# 安静时段，24 小时制，可以写小数；22.5 表示 22:30
PROACTIVE_QUIET_START=9
PROACTIVE_QUIET_END=22.5
PROACTIVE_MIN_MINUTES=20
PROACTIVE_MAX_MINUTES=90
# 主动消息里分享 B 站视频的概率，0 到 1
PROACTIVE_VIDEO_RATE=0.2
PROACTIVE_CHECK_SECONDS=30
PROACTIVE_START_DELAY_SECONDS=5
# 最近多少分钟内聊过就跳过本轮主动消息
PROACTIVE_ACTIVE_SKIP_MINUTES=10
# 主动消息生成失败后，隔多久重试
PROACTIVE_RETRY_MIN_MINUTES=10
PROACTIVE_RETRY_MAX_MINUTES=20
# ===== 未回复追问 =====
FOLLOWUP_FIRST_DELAY_MINUTES=5
FOLLOWUP_MIN_INTERVAL_MINUTES=55
FOLLOWUP_MAX_INTERVAL_MINUTES=70
FOLLOWUP_CHECK_SECONDS=15
